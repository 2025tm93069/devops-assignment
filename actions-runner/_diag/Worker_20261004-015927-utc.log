              "lit": "$jenkinsUrl = \"http://localhost:8080\"\n$jobName = \"aceest-app\"\n\n$credentials = \"${env:JENKINS_USER}:${env:JENKINS_TOKEN}\"\n$bytes = [System.Text.Encoding]::ASCII.GetBytes($credentials)\n$base64 = [Convert]::ToBase64String($bytes)\n\n$headers = @{\n    Authorization = \"Basic $base64\"\n}\n\n$url = \"$jenkinsUrl/job/$jobName/build\"\n\nWrite-Host \"Triggering Jenkins job: $jobName\"\n\nInvoke-WebRequest `\n  -Uri $url `\n  -Method POST `\n  -Headers $headers `\n  -UseBasicParsing\n\nWrite-Host \"Jenkins build triggered successfully.\""
            }
          },
